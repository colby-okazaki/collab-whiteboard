# Copy to server/.env.
# Leave DATABASE_URL unset to keep boards in memory only (lost on restart).
# Leave REDIS_URL unset to run a single server instance with in-memory live state.
DATABASE_URL=postgres://whiteboard:whiteboard@localhost:5432/whiteboard
REDIS_URL=redis://localhost:6379
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional per-connection message limit (a burst of CAPACITY, then PER_SECOND on average).
# RATE_LIMIT_CAPACITY=200
# RATE_LIMIT_PER_SECOND=100
